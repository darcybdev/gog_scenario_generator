gitattributes
# Automatically detect text files and normalize line endings
* text=auto

# Force specific Unity file types to use LF endings in the repository
*.uss text eol=lf
*.uxml text eol=lf
*.tss text eol=lf
*.meta text eol=lf

# Unity YAML files (like prefabs, scenes, and assets) should use LF
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
